# Serves the Angular SPA and proxies the backend under the same origin, so the
# httpOnly tidalis_session cookie stays first-party (see environment.ts).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Document uploads (backend MAX_UPLOAD_MB defaults to 25).
    client_max_body_size 50m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /api/ {
        proxy_pass ${BACKEND_URL};
    }

    location /docs {
        proxy_pass ${BACKEND_URL};
    }

    # MCP uses Server-Sent Events: no buffering, long-lived connections.
    location /mcp {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Hashed build output (main-XXXXXXXX.js, styles-XXXXXXXX.css, media/...) can be
    # cached forever; everything else falls through to the SPA location below.
    location ~* "(-[A-Z0-9]{8}\.(?:js|css)|^/media/.+)$" {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
