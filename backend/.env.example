# ---------------------------------------------------------------------------
# Tidalis Project References API - example environment
# Copy to .env and adjust where needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches the MariaDB container in the repository root docker-compose.yml
# (host port 3308 -> container 3306, db tidalis_references, user tidalis/changeme)
DATABASE_URL=mysql://tidalis:changeme@localhost:3308/tidalis_references

# --- HTTP -------------------------------------------------------------------
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# --- Document storage -------------------------------------------------------
# Directory on disk where uploaded project documents are stored. The database
# only holds the relative path, never the file contents.
STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=25

# --- Session cookie ---------------------------------------------------------
# Secret used to sign the `tidalis_session` httpOnly JWT cookie. Use a long
# random value in production.
JWT_SECRET=change_me_dev_secret
# Lifetime of the session cookie / JWT.
JWT_EXPIRES_IN=8h

# --- MCP server (for AI applications) ---------------------------------------
# Machine clients authenticate to /mcp with the `X-MCP-Key` header.
MCP_API_KEY=change_me_mcp_key

# --- Tidalis SSO (SAML 2.0) -------------------------------------------------
# !! These values must be requested from Tidalis IT / the owner of the SSO
# !! identity provider before SSO works end to end. See README.md.
#
# While SAML_IDP_CERT (or SAML_IDP_SSO_URL) is empty the SAML strategy is not
# registered: the app still boots and logs a warning, and /api/auth/saml/*
# returns 503. Set AUTH_DISABLED=true below to work on the API locally without
# any login at all.
SAML_SP_ENTITY_ID=urn:tidalis:project-references
SAML_ISSUER=urn:tidalis:project-references
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
# Base64 DER of the IdP signing certificate, on a single line (no PEM header /
# footer, no line breaks). Obtain from Tidalis IT.
SAML_IDP_CERT=
SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback
# SAML attribute/claim that carries the display name (optional).
SAML_NAME_ATTRIBUTE=

# --- Local development escape hatch -----------------------------------------
# When true, the global cookie guard injects a fake user instead of rejecting
# unauthenticated requests. NEVER enable this outside local development.
AUTH_DISABLED=false
DEV_USER_EMAIL=dev@tidalis.com

# --- Logging ----------------------------------------------------------------
# Log every SQL statement Prisma executes.
LOG_SQL=false
