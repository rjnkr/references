/// Metadata for a file uploaded against a contract. The file itself lives on
/// disk under STORAGE_DIR; only the relative path is stored here.
model ContractDocument {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id             Int      @id @default(autoincrement())
  /// @DtoRelationIncludeId
  contractId     Int
  /// @DtoRelationIncludeId
  documentTypeId Int
  /// Original filename as uploaded by the user
  /// @maxLength 255
  fileName       String   @db.VarChar(255)
  /// Path relative to STORAGE_DIR, e.g. "contracts/12/8f3a...c1.pdf"
  /// @maxLength 500
  filePath       String   @db.VarChar(500)
  /// Size in bytes
  fileSize       Int
  /// @maxLength 150
  mimeType       String   @db.VarChar(150)
  /// @DtoReadOnly
  uploadedAt     DateTime @default(now())
  /// Identifier (e-mail) of the user who uploaded the file
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 255
  uploadedBy     String?  @db.VarChar(255)

  /// @DtoReadOnly
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onUpdate: Cascade)

  @@index([contractId])
  @@index([documentTypeId])
  @@map("contract_documents")
}
