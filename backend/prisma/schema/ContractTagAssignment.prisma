/// Join table: the tags attached to a contract.
model ContractTagAssignment {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id         Int @id @default(autoincrement())
  /// @DtoRelationIncludeId
  contractId Int
  /// @DtoRelationIncludeId
  tagId      Int

  /// @DtoReadOnly
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  tag      Tag      @relation(fields: [tagId], references: [id], onUpdate: Cascade)

  @@unique([contractId, tagId])
  @@index([tagId])
  @@map("contract_tag_assignments")
}
