/// Join table: the Tidalis products (lookup) used by a system - zero or more.
model SystemProduct {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id        Int @id @default(autoincrement())
  /// @DtoRelationIncludeId
  systemId  Int
  /// @DtoRelationIncludeId
  productId Int

  /// @DtoReadOnly
  system  System  @relation(fields: [systemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  product Product @relation(fields: [productId], references: [id], onUpdate: Cascade)

  @@unique([systemId, productId])
  @@index([productId])
  @@map("system_products")
}
