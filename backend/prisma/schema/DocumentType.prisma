/// Lookup table classifying uploaded contract documents, e.g. "Signed contract".
model DocumentType {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id   Int    @id @default(autoincrement())
  /// @maxLength 100
  name String @unique @db.VarChar(100)

  systemDocuments   SystemDocument[]
  contractDocuments ContractDocument[]

  @@map("document_types")
}
