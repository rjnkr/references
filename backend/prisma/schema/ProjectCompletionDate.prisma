/// A date on which the customer accepted delivery. A project can have several
/// (phased delivery), each optionally described, e.g. "Phase 1".
model ProjectCompletionDate {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id             Int      @id @default(autoincrement())
  /// @DtoRelationIncludeId
  projectId      Int
  completionDate DateTime @db.Date
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 150
  description    String?  @db.VarChar(150)

  /// @DtoReadOnly
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId])
  @@map("project_completion_dates")
}
