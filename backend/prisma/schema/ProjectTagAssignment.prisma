/// Join table: the tags attached to a project.
model ProjectTagAssignment {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id        Int @id @default(autoincrement())
  /// @DtoRelationIncludeId
  projectId Int
  /// @DtoRelationIncludeId
  tagId     Int

  /// @DtoReadOnly
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  tag     Tag     @relation(fields: [tagId], references: [id], onUpdate: Cascade)

  @@unique([projectId, tagId])
  @@index([tagId])
  @@map("project_tag_assignments")
}
