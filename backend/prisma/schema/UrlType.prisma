/// Lookup table classifying a URL recorded against a contract or system, e.g. "Pipedrive".
model UrlType {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id   Int    @id @default(autoincrement())
  /// @maxLength 100
  name String @unique @db.VarChar(100)

  contractUrls ContractUrl[]
  systemUrls   SystemUrl[]

  @@map("url_types")
}
