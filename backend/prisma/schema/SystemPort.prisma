/// Join table: the ports (UN/LOCODE locations) a system covers.
model SystemPort {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id         Int @id @default(autoincrement())
  /// @DtoRelationIncludeId
  systemId   Int
  /// @DtoRelationIncludeId
  unlocodeId Int

  /// @DtoReadOnly
  system   System   @relation(fields: [systemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  unlocode UnLocode @relation(fields: [unlocodeId], references: [id], onUpdate: Cascade)

  @@unique([systemId, unlocodeId])
  @@index([unlocodeId])
  @@map("system_ports")
}
