/// A commercial project/deal, usable as a Tidalis reference. Its system-side facts
/// (scope, products, location, ports, modules, ...) live on the linked System - see
/// `systemId` below.
model Project {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id                      Int       @id @default(autoincrement())
  /// Internal Tidalis project number
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 50
  projectNumber           String?   @unique @db.VarChar(50)
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 100
  name                    String?   @db.VarChar(100)
  /// Date the project was awarded (date only, no time component)
  awardDate               DateTime  @db.Date
  /// Date the project ended, or is expected to end (date only). Optional - many
  /// projects are still ongoing.
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  endDate                 DateTime? @db.Date
  /// Multi-select: which phase(s) this project covers - a JSON array of `ProjectTag`
  /// values (e.g. `["IMPLEMENTATION", "SM"]` for a project that is both). Not to be
  /// confused with `System.projectType` (the delivered system's technical category).
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  projectType             Json      @default("[]")
  /// Commercial / implementation price in whole currency units
  implementationPrice     Int
  /// Yearly maintenance price in whole currency units
  maintenancePricePerYear Int
  /// @DtoRelationIncludeId
  currencyId              Int
  /// The System this project relates to. Not every project links to a System (and several
  /// projects - e.g. an implementation plus later maintenance renewals - can link to the
  /// same one).
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @DtoRelationIncludeId
  systemId                Int?
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  newDevelopments         String?   @db.Text
  /// What was special about the implementation of this project
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  implementationDetails   String?   @db.Text
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 50
  pipedriveNumber         String?   @db.VarChar(50)
  /// Internal note - Tidalis employees only. Never expose this field to customers or
  /// through any public-facing output (AI/MCP tools, reference search, customer-facing
  /// exports) - it must stay confined to the internal admin UI/API.
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  internalNotes           String?   @db.Text
  /// Soft-delete flag. A "deleted" project is hidden from every normal read (list,
  /// detail, MCP tools) exactly as if it had been hard-deleted, but the row and all
  /// of its child data are kept so it can be restored from its audit trail entry.
  /// @DtoReadOnly
  deleted                 Boolean   @default(false)
  /// @DtoReadOnly
  createdAt               DateTime  @default(now())
  /// @DtoReadOnly
  updatedAt               DateTime  @updatedAt

  /// @DtoReadOnly
  currency Currency @relation(fields: [currencyId], references: [id], onUpdate: Cascade)
  /// @DtoReadOnly
  system   System?  @relation(fields: [systemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  completionDates ProjectCompletionDate[]
  documents       ProjectDocument[]
  tags            ProjectTagAssignment[]
  urls            ProjectUrl[]

  @@index([currencyId])
  @@index([systemId])
  @@index([deleted])
  @@map("projects")
}
