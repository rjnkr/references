/// A URL recorded against a project (e.g. its Pipedrive deal), classified by `UrlType`.
model ProjectUrl {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id          Int     @id @default(autoincrement())
  /// @DtoRelationIncludeId
  projectId   Int
  /// @DtoRelationIncludeId
  urlTypeId   Int
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 255
  description String? @db.VarChar(255)
  /// @maxLength 500
  url         String  @db.VarChar(500)

  /// @DtoReadOnly
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  urlType UrlType @relation(fields: [urlTypeId], references: [id], onUpdate: Cascade)

  @@index([projectId])
  @@index([urlTypeId])
  @@map("project_urls")
}
