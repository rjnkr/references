/// A URL recorded against a contract (e.g. its Pipedrive deal), classified by `UrlType`.
model ContractUrl {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id          Int     @id @default(autoincrement())
  /// @DtoRelationIncludeId
  contractId  Int
  /// @DtoRelationIncludeId
  urlTypeId   Int
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 255
  description String? @db.VarChar(255)
  /// @maxLength 500
  url         String  @db.VarChar(500)

  /// @DtoReadOnly
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// @DtoReadOnly
  urlType  UrlType  @relation(fields: [urlTypeId], references: [id], onUpdate: Cascade)

  @@index([contractId])
  @@index([urlTypeId])
  @@map("contract_urls")
}
