/// A date on which the customer accepted delivery. A contract can have several
/// (phased delivery), each optionally described, e.g. "Phase 1".
model ContractCompletionDate {
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  id             Int      @id @default(autoincrement())
  /// @DtoRelationIncludeId
  contractId     Int
  completionDate DateTime @db.Date
  /// @DtoCreateOptional
  /// @DtoUpdateOptional
  /// @maxLength 150
  description    String?  @db.VarChar(150)

  /// @DtoReadOnly
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([contractId])
  @@map("contract_completion_dates")
}
