/// The kind of system Tidalis delivered for a contract.
enum ContractType {
  PMIS
  VTS
  AIS
  COASTAL
  PILOT
  OTHER
}

/// The kind of change a ContractAuditLog entry records.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

/// Which phase(s) of work a Contract covers. Stored as a JSON array on
/// `Contract.contractType` - MySQL has no native scalar-list column type - so a contract
/// can carry either, both, or neither. `SM` = Support & Maintenance.
enum ContractTag {
  IMPLEMENTATION
  SM
  PROOF_OF_CONCEPT
  STUDY
  CONSULTANCY
  REQUIREMENT_ANALYSIS
}
